{
  "name": "Hard Clip Development Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "mounts": [
    {
      "source": "${localEnv:HOME}/.ssh",
      "target": "/home/vscode/.ssh",
      "type": "bind"
    }
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "eamodio.gitlens",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "ms-vscode.cpptools-extension-pack"
      ],
      "settings": {}
    }
  }
}
